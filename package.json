{
  "private": true,
  "name": "vsp-otel-workspace",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -C runtime build",
    "test": "pnpm -C runtime test && pnpm run test:gates",
    "test:gates": "pnpm -C runtime exec vitest run --root .. --config vitest.gates.config.mjs",
    "lint": "eslint runtime/src --ext .ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "^10.14.0",
    "@typescript-eslint/parser": "8.72.1",
    "globals": "17.14.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=8.1.6",
      "minimatch@<11.0.1": "11.0.3"
    }
  }
}
